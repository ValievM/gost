{
  "name": "@magomed-cmd/gost",
  "version": "1.0.0",
  "description": "GOST 7.32 document generation library for .docx and .xlsx — headings, tables, formulas, images, AHP matrices",
  "author": "magomed-cmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Magomed-cmd/gost.git"
  },
  "homepage": "https://github.com/Magomed-cmd/gost#readme",
  "bugs": {
    "url": "https://github.com/Magomed-cmd/gost/issues"
  },
  "keywords": [
    "gost",
    "gost-7.32",
    "docx",
    "xlsx",
    "report",
    "document",
    "word",
    "excel",
    "generator",
    "academic",
    "university",
    "russian",
    "table-of-contents",
    "math",
    "formula",
    "ahp"
  ],
  "exports": {
    "./docx": {
      "require": "./dist/docx-gost.js",
      "types": "./dist/docx-gost.d.ts"
    },
    "./excel": {
      "require": "./dist/excel-gost.js",
      "types": "./dist/excel-gost.d.ts"
    },
    "./plantuml": {
      "require": "./dist/plantuml-gost.js",
      "types": "./dist/plantuml-gost.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples/docx/minimal.cjs",
    "examples/plantuml/render-all.mjs",
    "scripts/check-docs.mjs",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:docs": "node scripts/check-docs.mjs",
    "check:examples": "node --check examples/docx/minimal.cjs && node --check examples/plantuml/render-all.mjs",
    "example:docx": "npm run build && node examples/docx/minimal.cjs",
    "example:plantuml": "npm run build && node examples/plantuml/render-all.mjs",
    "verify": "npm run build && npm test -- --runInBand && npm run check:docs && npm run check:examples"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "node-plantuml": "^0.9.0"
  },
  "peerDependencies": {
    "googleapis": ">=140"
  },
  "peerDependenciesMeta": {
    "googleapis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "googleapis": "^173.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.0"
  }
}
